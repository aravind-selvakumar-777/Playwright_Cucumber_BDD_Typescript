{
  "name": "playwright_bdd_typescipt",
  "version": "1.0.0",
  "scripts": {
    "test": "npx cucumber-js --tags \"not @preStep\"",
    "preTest": "npx cucumber-js --tags @preStep --parallel 1",
    "test:chromium": "cross-env BROWSER=chromium npm run test",
    "test:firefox": "cross-env BROWSER=firefox npm run test",
    "test:webkit": "cross-env BROWSER=webkit npm run test",
    "lint": "npx eslint . --fix"
  },
  "author": "Arima",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.56.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "playwright": "^1.56.1",
    "playwright-bdd": "^8.4.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}